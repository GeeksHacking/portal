{
  "name": "@geekshacking/portal-sdk",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./hooks/*": {
      "types": "./dist/gen/hooks/*.d.ts",
      "import": "./dist/gen/hooks/*.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    },
    "./zod/*": {
      "types": "./dist/gen/zod/*.d.ts",
      "import": "./dist/gen/zod/*.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./testing/handlers": {
      "types": "./dist/testing/handlers.d.ts",
      "import": "./dist/testing/handlers.js"
    },
    "./testing/handlers/*": {
      "types": "./dist/gen/handlers/*.d.ts",
      "import": "./dist/gen/handlers/*.js"
    },
    "./testing/mocks": {
      "types": "./dist/testing/mocks.d.ts",
      "import": "./dist/testing/mocks.js"
    },
    "./testing/mocks/*": {
      "types": "./dist/gen/mocks/*.d.ts",
      "import": "./dist/gen/mocks/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown -w",
    "generate": "kubb generate",
    "codegen": "kubb generate && tsdown",
    "postinstall": "tsdown"
  },
  "dependencies": {
    "@kubb/plugin-fetch": "^5.5.1",
    "@tanstack/query-core": "^5.104.0"
  },
  "devDependencies": {
    "@kubb/cli": "^5.3.19",
    "@kubb/plugin-faker": "^5.0.11",
    "@kubb/plugin-msw": "^5.0.4",
    "@kubb/plugin-oas": "^4.39.3",
    "@kubb/plugin-ts": "^5.0.2",
    "@kubb/plugin-vue-query": "^5.1.3",
    "@kubb/plugin-zod": "^5.3.0",
    "kubb": "^5.3.18",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.6.0",
  "peerDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@tanstack/vue-query": "^5.92.9",
    "msw": "^2.13.6",
    "vue": "^3.5.28",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
